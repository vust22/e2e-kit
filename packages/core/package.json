{
  "name": "@invertus/e2e-core",
  "version": "0.2.2",
  "description": "Runner glue, fixtures, PSP contract, healing harness and reporting for the Invertus E2E kit",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./psp": {
      "types": "./dist/psp/index.d.ts",
      "import": "./dist/psp/index.js"
    },
    "./healing": {
      "types": "./dist/healing/index.d.ts",
      "import": "./dist/healing/index.js"
    },
    "./playwright-preset": {
      "types": "./dist/reporting/preset.d.ts",
      "import": "./dist/reporting/preset.js"
    }
  },
  "bin": {
    "e2e-kit": "./bin/e2e-kit.js"
  },
  "files": [
    "dist",
    "bin",
    "compose"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@playwright/test": "1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
