{
  "name": "@invertus/e2e-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Central E2E testing kit for PrestaShop modules and shops",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/consumer-module",
    "pilots/mollie"
  ],
  "bin": {
    "e2e-kit": "packages/core/bin/e2e-kit.js"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test:unit": "npm run build && node --test packages/*/test/*.test.mjs",
    "kit:up": "node packages/core/bin/e2e-kit.js up",
    "kit:test": "node packages/core/bin/e2e-kit.js test",
    "kit:down": "node packages/core/bin/e2e-kit.js down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.20.0"
  }
}
