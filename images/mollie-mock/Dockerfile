# Mollie API mock (spec §6.4).
#
# Built and tagged locally as `e2e-mock-mollie:latest` by `scripts/build-image.mjs`; the GHCR
# push (`ghcr.io/invertus/e2e-mock-mollie`) waits for Phase 2 along with every other publish
# step (DECISIONS.md D-006).
#
# The leaf certificate for `api.mollie.com` is copied in at build time from
# `images/prestashop/e2e-ca/leaf/api.mollie.com/`, which is generated by `scripts/gen-ca.mjs`
# in the same invocation that bakes the CA into the PrestaShop image. That shared origin is
# what makes the two images trust each other — and why they must be built together.

FROM node:22-bookworm-slim

ENV NODE_ENV=production

WORKDIR /app

# Dependencies first, so editing the mock's source does not re-resolve npm.
COPY images/mollie-mock/package.json images/mollie-mock/package-lock.json ./
RUN npm ci --omit=dev

COPY images/mollie-mock/src ./src
COPY images/prestashop/e2e-ca/leaf/api.mollie.com/server.crt /etc/mollie-mock/tls/server.crt
COPY images/prestashop/e2e-ca/leaf/api.mollie.com/server.key /etc/mollie-mock/tls/server.key

# Binding :443 needs the capability, not the whole root user.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && setcap 'cap_net_bind_service=+ep' "$(readlink -f "$(command -v node)")" \
    && rm -rf /var/lib/apt/lists/*

RUN chown -R node:node /etc/mollie-mock
USER node

EXPOSE 443 8090

HEALTHCHECK --interval=3s --timeout=3s --retries=20 --start-period=2s \
  CMD node -e "fetch('http://127.0.0.1:8090/__admin/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/server.mjs"]
